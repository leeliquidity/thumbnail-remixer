ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Optional: only for `find` (viral outlier search) — free key from Google Cloud console, enable YouTube Data API v3
YOUTUBE_API_KEY=
# Optional: Telegram front-end
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=          # comma-separated Telegram user IDs; blank = anyone
THUMBS_PER_RUN=2
# Overrides
ANALYZE_MODEL=claude-sonnet-5-5
IMAGE_MODEL=gpt-image-1
